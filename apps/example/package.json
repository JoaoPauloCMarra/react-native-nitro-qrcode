{
  "name": "example",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "env -u NO_COLOR expo start -d",
    "web": "env -u NO_COLOR expo start --web",
    "ios": "env -u NO_COLOR expo run:ios",
    "android": "bun run android:assemble && env -u NO_COLOR expo run:android --binary android/app/build/outputs/apk/debug/app-debug.apk",
    "prebuild": "env -u NO_COLOR expo prebuild",
    "prebuild:clean": "env -u NO_COLOR expo prebuild --clean",
    "lint": "bunx eslint app --max-warnings=0",
    "install-check": "env -u NO_COLOR expo install --check",
    "config:introspect": "env -u NO_COLOR expo config --type introspect --json > /tmp/nitro-qrcode-expo-config.json",
    "doctor": "env -u NO_COLOR bunx expo-doctor",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "android:assemble": "cd android && NODE_ENV=development ./gradlew --no-daemon --no-configuration-cache -PreactNativeArchitectures=arm64-v8a :app:assembleDebug",
    "ios:build": "cd ios && pod install && xcodebuild -workspace NitroQRCode.xcworkspace -scheme NitroQRCode -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "check": "bun run lint && bun run typecheck && bun run doctor"
  },
  "dependencies": {
    "expo": "~57.0.16",
    "expo-build-properties": "~57.0.14",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "0.37.0",
    "react-native-nitro-qrcode": "workspace:*",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.18"
  }
}
