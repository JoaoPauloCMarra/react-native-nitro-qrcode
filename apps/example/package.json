{
  "name": "example",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "env -u NO_COLOR expo start -d",
    "web": "env -u NO_COLOR expo start --web",
    "ios": "env -u NO_COLOR expo run:ios",
    "android": "bun run android:assemble && env -u NO_COLOR expo run:android --binary android/app/build/outputs/apk/debug/app-debug.apk",
    "prebuild": "env -u NO_COLOR expo prebuild",
    "prebuild:clean": "env -u NO_COLOR expo prebuild --clean",
    "lint": "bunx eslint app components plugins metro.config.js app.config.js --max-warnings=0",
    "install-check": "env -u NO_COLOR expo install --check",
    "config:introspect": "env -u NO_COLOR expo config --type introspect --json > /tmp/nitro-qrcode-expo-config.json",
    "doctor": "env -u NO_COLOR bunx expo-doctor@1.21.5",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "android:assemble": "cd android && NODE_ENV=development ./gradlew --no-daemon --no-configuration-cache :app:assembleDebug",
    "ios:build": "cd ios && pod install && xcodebuild -workspace NitroQRCode.xcworkspace -scheme NitroQRCode -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "check": "bun run lint && bun run typecheck && bun run doctor"
  },
  "dependencies": {
    "expo": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-qrcode": "workspace:*",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "fflate": "0.8.3",
    "jsqr": "1.4.0"
  }
}
