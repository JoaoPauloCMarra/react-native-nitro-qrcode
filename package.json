{
  "name": "react-native-nitro-qrcode-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.js",
    "publish-package": "bun scripts/publish.js",
    "publish-package:dry-run": "bun scripts/publish.js --dry-run --skip-checks",
    "build": "bun run --cwd packages/react-native-nitro-qrcode build",
    "dev": "bun run example:start",
    "check": "bun run lint:check && bun run typecheck && bun run test:types && bun run test:coverage && bun run test:cpp && bun run build && bun run example:check && bun run example:smoke:ci && bun run test:lifecycle",
    "check:ci": "bun run verify:core-versions && bun run check && bun run test:cpp:sanitize && bun run typecheck:rn087",
    "release:preflight": "bun run check:ci && bun run benchmark:cpp && bun run audit:package && bun run publish-package:dry-run && bun run example:smoke",
    "lint": "bun run --cwd packages/react-native-nitro-qrcode lint",
    "lint:check": "bun run --cwd packages/react-native-nitro-qrcode lint:check",
    "clean": "bun run --cwd packages/react-native-nitro-qrcode clean",
    "codegen": "bun run --cwd packages/react-native-nitro-qrcode codegen",
    "codegen:check": "bun scripts/check-codegen.js",
    "verify:core-versions": "bun scripts/verify-core-versions.ts",
    "typecheck": "bun run --cwd packages/react-native-nitro-qrcode typecheck",
    "typecheck:rn087": "bun scripts/verify-rn087-types.ts",
    "test:types": "bun run --cwd packages/react-native-nitro-qrcode test:types",
    "test": "bun run --cwd packages/react-native-nitro-qrcode test",
    "test:lifecycle": "node scripts/package-doc-lifecycle.test.js && node --test ./scripts/assert-example-smoke.test.js && bun scripts/assert-publish-workflow.js && bun test ./scripts/assert-publish-workflow.test.js",
    "test:unit": "bun run --cwd packages/react-native-nitro-qrcode test",
    "test:coverage": "bun run --cwd packages/react-native-nitro-qrcode test:coverage",
    "test:cpp": "bun run --cwd packages/react-native-nitro-qrcode test:cpp",
    "test:cpp:sanitize": "bun scripts/test-cpp-sanitize.js",
    "benchmark:cpp": "bun scripts/benchmark-cpp.js",
    "benchmark:cpp:smoke": "bun scripts/benchmark-cpp.js --smoke",
    "audit:package": "bun scripts/audit-package-contents.js",
    "example:lint": "bun run --cwd apps/example lint",
    "example:doctor": "bun run --cwd apps/example doctor",
    "example:typecheck": "bun run --cwd apps/example typecheck",
    "example:install-check": "bun run --cwd apps/example install-check",
    "example:config": "bun run --cwd apps/example config:introspect",
    "example:check": "bun run example:lint && bun run example:typecheck && bun run example:install-check && bun run example:doctor && bun run example:config",
    "example:smoke": "bun scripts/assert-example-smoke.js",
    "example:smoke:ci": "bun scripts/assert-example-smoke.js --self-check",
    "example:e2e": "agent-device test e2e/qa-full-features.ad --retries 1",
    "example:e2e:android": "agent-device test e2e/qa-full-features.ad --device \"RN Expo MidRange\" --retries 1",
    "example:e2e:ios": "agent-device test e2e/qa-full-features.ad --device \"iPhone 17 Pro Max (iOS 26.5)\" --retries 1",
    "example:e2e:render": "agent-device test e2e/qa-render-stress.ad --retries 1",
    "example:e2e:render:android": "agent-device test e2e/qa-render-stress.ad --device \"RN Expo MidRange\" --retries 1",
    "example:e2e:render:ios": "agent-device test e2e/qa-render-stress.ad --device \"iPhone 17 Pro Max (iOS 26.5)\" --retries 1",
    "example:e2e:deeplink": "agent-device test e2e/qa-deeplink.ad --retries 1",
    "example:e2e:deeplink:android": "agent-device test e2e/qa-deeplink.ad --device \"RN Expo MidRange\" --retries 1",
    "example:e2e:deeplink:ios": "agent-device test e2e/qa-deeplink.ad --device \"iPhone 17 Pro Max (iOS 26.5)\" --retries 1",
    "example:start": "bun run --cwd apps/example start",
    "example:web": "bun run --cwd apps/example web",
    "example:ios": "bun run --cwd apps/example ios",
    "example:android": "bun run --cwd apps/example android",
    "example:android:assemble": "bun run --cwd apps/example android:assemble",
    "example:ios:build": "bun run --cwd apps/example ios:build",
    "example:logs:ios": "xcrun simctl spawn booted log stream --style compact --predicate 'process == \"NitroQRCodeExample\" OR eventMessage CONTAINS \"ReactNativeJS\" OR eventMessage CONTAINS \"NitroQRCode\"'",
    "example:logs:android": "adb logcat ReactNativeJS:I NitroQRCodeOnLoad:I NitroModules:I AndroidRuntime:E '*:S'",
    "example:prebuild": "bun run --cwd apps/example prebuild",
    "example:prebuild:clean": "bun run --cwd apps/example prebuild:clean"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.18",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "nitrogen": "0.37.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-nitro-modules": "0.37.1",
    "react-test-renderer": "19.2.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "caniuse-lite": "1.0.30001810",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "@types/react": "~19.2.18"
  },
  "engines": {
    "node": ">=20.19.4",
    "bun": ">=1.3.11"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@swc/core",
    "unrs-resolver"
  ]
}
